# physical-harness -- machine-local console configuration.
#
#   cp .env.example .env      # then edit; `.env` is git-ignored, NEVER commit it
#
# Three readers, one file:
#
#   1. dsh's credential store reads it with NO help from us. Its precedence is
#      process env > $DSH_HOME/.credentials.yaml > <cwd>/.env > $DSH_HOME/.env,
#      and `scripts/cockpit` cds to the repo root before starting the console,
#      so THIS file is the <cwd>/.env layer. Put API keys here.
#   2. `profiles/dsh/deploy_profile.py` reads the PH_MODEL_* keys when it renders
#      $DSH_HOME/cordis.patch.yml from profiles/dsh/cordis.patch.template.yml.
#   3. `scripts/cockpit` reads PH_CONSOLE_PORT / PH_TRUSTED_HOST (a --port /
#      --trusted-host flag still wins).
#
# Format: KEY=value, one per line. `#` starts a comment line only (not an inline
# one), a leading `export ` is allowed, one layer of matching quotes is stripped,
# and the last assignment of a key wins.
#
# THIS FILE CARRIES NO REAL KEY and never will -- it is committed.

# ── credentials ──────────────────────────────────────────────────────────────

# The backbone route's credential. It is a PLACEHOLDER but it is NOT optional:
# a hand-declared LLM route always declares apiKey auth (there is no spelling
# for "keyless"), so without this every request fails up front with
# `PI_AI_ERROR: No API key for provider: local-qwen`. A local server ignores the
# header it ends up sending. Any non-empty string works.
LOCAL_QWEN_API_KEY=local-no-auth

# Only needed if you switch the console back to a hosted DeepSeek model.
# DEEPSEEK_API_KEY=

# ── backbone LLM route (rendered into $DSH_HOME/cordis.patch.yml) ────────────
#
# Any OpenAI-compatible server works -- sglang, vLLM, llama.cpp, a gateway.
# Nothing interrogates the endpoint, so these four values ARE the route.
# An agent needs a server started with a tool-call parser (for the reference
# Qwen3.8-27B deployment: --tool-call-parser qwen3_coder), or tool calls come
# back as prose and nothing is ever invoked.

PH_MODEL_BASE_URL=http://127.0.0.1:30001/v1
PH_MODEL_ID=qwen3.8-27b
PH_MODEL_DISPLAY=Qwen3.8-27B (local)
# The env var name the route resolves its key through -- rename it and rename
# the credential above with it.
PH_MODEL_KEY_ENV=LOCAL_QWEN_API_KEY

# ── console ──────────────────────────────────────────────────────────────────

PH_CONSOLE_PORT=3080
# dsh binds 127.0.0.1 only. Set this when the operator's browser is on another
# machine and you forward the port (e.g. socat); leave empty otherwise.
PH_TRUSTED_HOST=
# 1 = `scripts/cockpit` also starts the local model server (same as --with-model)
# and `cockpit --status` flags a STOPPED one as a problem. 0/empty = leave it alone.
PH_WITH_MODEL=
# 1 = `scripts/cockpit` also starts the pi0.5 policy server on :8000 (same as
# --with-policy) and `--status` flags a STOPPED one as a problem.
PH_WITH_POLICY=
# Checkpoint dir the policy server loads (default: the gate2_bs8/199 LoRA under
# ~/Desktop/Learning_based_model/openpi/checkpoints/pi05_robocasa_lora).
# PH_POLICY_CHECKPOINT=

# ── paths (derived from the repo root; override only if your layout differs) ──
#
# PH_PYTHON=/abs/path/to/repo/.venv/bin/python
# PH_MCP_SERVER=/abs/path/to/repo/board/mcp_server.py
# PH_RUNS=/abs/path/to/repo/runs

# PH_NO_RENDER=1  keep session-main headless even with a DISPLAY (the local MuJoCo
#   window + --frames segfault inside robosuite offscreen render; LAN operators use the browser viewport)
