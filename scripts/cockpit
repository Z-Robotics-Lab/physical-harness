#!/usr/bin/env bash
# physical-harness cockpit -- the SINGLE native entry for the lab console.
#
# operators run:  scripts/cockpit            (start EVERYTHING; leaves it running)
#                 scripts/cockpit --status    (is my system healthy? FIRST command)
#                 scripts/cockpit --stop      (stop what THIS cockpit started)
# never:          npx @deepseek-ai/dsh web ...  /  a second terminal for the runtime
#
# WHAT IT STARTS (operator is UI-only -- no second terminal):
#   1. the resident harness_runtime on runs/session-main (adopt-or-spawn, below)
#   2. the STACK EVOLUTION runtime on runs/session-main-rsi (the robosuite
#      interpreter, --mode evolution, headless egl)
#   3. the KITCHEN runtime on runs/session-robocasa (--frames, robocasa venv,
#      headless egl)
#   4. the KITCHEN EVOLUTION runtime on runs/session-robocasa-rsi (--mode evolution
#      --frames, same venv, headless egl)
#      2 through 4 are ON by default for ONE reason: they are inboxes the console
#      can submit into, and an inbox nobody serves is where briefs go to rot --
#      three times now (RSI brief idle 21h on 8/27, the web reap on 8/28, the
#      recycle_cans brief on 8/29 that sat in session-robocasa because cockpit
#      did not start it and a residual status file said the corpse was up).
#      "the robocasa card is enabled=false until phase 3/4" was the old reason
#      to leave 2 off; phase 3 shipped and the console submits kitchen tasks by
#      hand now, so the reason died and the default follows it. Both skipped
#      with one warning if the robocasa venv is absent.
#   5. the web console (the ph-station fork build)
#
# RUNTIME adopt-vs-spawn: harness_runtime.py now guards its own session dir (an
#   exclusive flock on runs/<session>/runtime.lock; a second instance refuses to
#   start and names the holding pid, and the lock dies with the process). Cockpit's
#   `ps` scan is the FRIENDLY half of the same rule -- it adopts instead of racing,
#   so the lock only ever speaks when something bypassed cockpit. If one exists on
#   runs/session-main it is ADOPTED (its PID printed, NOT restarted). Adoption
#   keeps ownership: a pid this session's pidfile already records as spawned
#   (runtime_adopted=0) stays reapable by --stop; only a runtime no cockpit
#   started is left alone.
#   If none exists cockpit SPAWNS one (nohup, logged to runs/session-main/
#   runtime.log) and records its PID so --stop can kill it. --render is passed IFF
#   $DISPLAY is set (the runtime hard-refuses --render headless); headless spawns
#   get MUJOCO_GL=egl for offscreen sim. Opt out with --no-runtime / --no-render.
#   Every spawn also gets NUMBA_CACHE_DIR under its session dir, and $REPO/
#   .robocasa-fix ahead of $REPO on PYTHONPATH when that (untracked, host-local)
#   directory exists -- see runtime_up() for why a boot dies without them.
#
# --stop kills BOTH the web server and any runtime cockpit SPAWNED, by the exact
#   PIDs recorded in the pidfile (never pkill-by-pattern -- that would match
#   operator shells). An ADOPTED runtime is left running.
#
# HOW IT SERVES: the ph-station fork's own build. brand is NATIVE in fork source
#   (no launch-time string patching). it (1) sources nvm (node 22), (2) seeds the
#   workspace user-data record, (3) serves the console from the built fork bin.
#   (the pre-fork npx + profiles/dsh/rebrand.sh overlay retired once the fork
#   reached parity -- see local-archive/docs/retired-from-public/ph-station-design.md
#   §6, kept on the operator's box only.)
#
# the harness MCP integration is loaded from $DSH_HOME/cordis.patch.yml -- there
# is NO `--patch` flag on `dsh web`. That file is RENDERED here on every start by
# profiles/dsh/deploy_profile.py from the committed template; a fresh clone
# therefore reaches a tool-equipped console with no manual copy.
set -o pipefail
set -u

DO_STOP=0
DO_STATUS=0
DO_RESTART=0
DO_BUILD=0
NO_RUNTIME=0
# PH_NO_RENDER=1 (.env) keeps session-main headless even when DISPLAY is set:
# the local MuJoCo window plus --frames (browser viewport) segfaults inside
# robosuite's offscreen render (2026-09-03), and a LAN operator never sees the
# window anyway. --no-render on the command line does the same for one run.
NO_RENDER=0  # resolved from .env below, after _env_get exists
SESSION_DIR="runs/session-main"          # cockpit's canonical resident session
STACK_EVOLUTION_SESSION_DIR="runs/session-main-rsi"
ROBOCASA_SESSION_DIR="runs/session-robocasa"
EVOLUTION_SESSION_DIR="runs/session-robocasa-rsi"  # evolution runtime; ON by default

usage() {
  cat <<EOF
physical-harness cockpit -- the single entry that starts EVERYTHING

usage: cockpit [--port N] [--no-render] [--no-runtime]
       cockpit --status
       cockpit --stop
       cockpit --restart [--build]
       cockpit -h|--help

  --status       print system health and exit, starting nothing. THE FIRST
                 COMMAND when anything looks wrong: per session the runtime's
                 real liveness (asked of /proc, never of its own leftover
                 runtime_status.json) + heartbeat age + inbox backlog + crash
                 orphans, then the console and the model server. Exit 0 when
                 healthy, 1 when it found a problem. The console's health tool
                 and 'python -m board.storecli health' print the same face.
  --port N       port to serve the console on (default: PH_CONSOLE_PORT from
                 the repo's .env, else 3080)
  --trusted-host H  also trust gateway requests arriving via host H (dsh binds
                 127.0.0.1 only; pair this with a LAN forward like socat when
                 the operator's browser is on another machine). Default:
                 PH_TRUSTED_HOST from the repo's .env, else unset.
  --no-render    spawn the runtime headless even with a display attached
                 (default: --render IFF \$DISPLAY is set; the runtime refuses
                 --render without a display)
  --no-runtime   do not adopt or spawn ANY runtime (execution or evolution);
                 serve only the web console (the pre-single-entry behavior)
  --with-robocasa  accepted and ignored: $ROBOCASA_SESSION_DIR is now ON by
                 default, like every other session. Kept so an old command line
                 still works. Override the interpreter with ROBOCASA_PYTHON=...
                 (default \$REPO/../sims/robocasa-venv/bin/python); --no-runtime
                 is how you start none of them.
  --with-model   also start the local model server (board.store.model_server
                 'start', llama.cpp on 127.0.0.1:30001) and wait until it
                 answers /v1/models before serving. Off by default; PH_WITH_MODEL=1
                 in the repo's .env turns it on. --status flags a STOPPED model
                 as a problem only when this is on.
  --with-policy  also start the pi0.5 policy server (board.store.policy_server
                 'start': scripts/serve_vla_openpi.py under openpi's venv on
                 127.0.0.1:8000, checkpoint from PH_POLICY_CHECKPOINT) and wait
                 until it serves. Off by default; PH_WITH_POLICY=1 in .env turns
                 it on. --status flags a STOPPED policy only when this is on;
                 --stop reaps it by the exact pid in runs/policy-server.pid.
  --stop         stop the web server and any runtime THIS cockpit spawned, by the
                 exact PIDs in each session's pidfile. A runtime some earlier
                 cockpit spawned counts as spawned (ownership survives a
                 console-only restart); one started outside cockpit is left
                 running. Reaps every session (main + robocasa) it recorded.
  --restart      --stop then the normal start, DETACHED (setsid; this call
                 returns at once -- the console button that presses it is about
                 to die). Progress goes to runs/restart.log, which health()
                 reports as its "restart" row. --with-policy is re-added only if
                 the policy server was SERVING before (never by default).
  --build        with --restart: run 'pnpm build' in \$PH_STATION first; a
                 failed build aborts the restart and starts nothing.
  -h, --help     show this help

Before serving it renders \$DSH_HOME/cordis.patch.yml from
profiles/dsh/cordis.patch.template.yml (the console's MCP tools, LLM route and
default agent preset) and seeds the workspace record. Both are idempotent.

Starting (no --stop) brings up five things and leaves them running:
  1. the resident harness_runtime on $SESSION_DIR --
       ADOPTED if one is already serving it (PID printed, not restarted, not
       killed by --stop), otherwise SPAWNED (nohup, logged) and recorded for
       --stop. Never two runtimes on one session dir.
  2. the STACK EVOLUTION runtime on $STACK_EVOLUTION_SESSION_DIR (robosuite
       venv, --mode evolution, headless MUJOCO_GL=egl). This is the inbox for
       {"kind":"rsi","task":"stack"}; execution and evolution never share a
       resident runtime.
  3. the KITCHEN runtime on $ROBOCASA_SESSION_DIR (--frames, robocasa venv,
       headless MUJOCO_GL=egl) -- same adopt-or-spawn discipline, ON by default.
  4. the KITCHEN EVOLUTION runtime on $EVOLUTION_SESSION_DIR (--mode evolution --frames,
       robocasa venv, headless MUJOCO_GL=egl) -- likewise ON by default.
     These are all inboxes the console submits into; an un-managed dead
     runtime on either is how briefs got dropped into a dead inbox. Both are
     skipped with one warning when the robocasa venv is absent.
  5. the web console (the ph-station fork build).

serves the ph-station fork build (native brand). use this instead of running
'npx @deepseek-ai/dsh web' or a second terminal for the runtime.
EOF
}

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO="$(cd "$HERE/.." && pwd -P)"

# Defaults come from the repo root's git-ignored .env (see .env.example); a flag
# below still wins. The file is READ, never sourced -- exporting it would put
# credentials in the process environment, which outranks the console's own
# credential store and would shadow a key the Models page writes. Same parse
# rules as profiles/dsh/deploy_profile.py: comment lines and blanks skipped,
# `export ` dropped, one layer of matching quotes stripped, last assignment wins.
_env_get() {
  [ -f "$REPO/.env" ] || return 0
  local line out=""
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "$1="*)          out="${line#*=}";;
      "export $1="*)   out="${line#*=}";;
      *) continue;;
    esac
  done < "$REPO/.env"
  out="${out%\"}"; out="${out#\"}"; out="${out%\'}"; out="${out#\'}"
  printf '%s' "$out"
}

PORT="$(_env_get PH_CONSOLE_PORT)"; PORT="${PORT:-3080}"
TRUSTED_HOST="$(_env_get PH_TRUSTED_HOST)"
WITH_MODEL="$(_env_get PH_WITH_MODEL)"; WITH_MODEL="${WITH_MODEL:-0}"
WITH_POLICY="$(_env_get PH_WITH_POLICY)"; WITH_POLICY="${WITH_POLICY:-0}"
NO_RENDER_ENV="$(_env_get PH_NO_RENDER)"; [ "${NO_RENDER_ENV:-0}" = "1" ] && NO_RENDER=1
POLICY_CHECKPOINT="$(_env_get PH_POLICY_CHECKPOINT)"
ORIG_ARGS=("$@")

while [ $# -gt 0 ]; do
  case "$1" in
    --port)   PORT="${2:?--port needs a value}"; shift 2;;
    --port=*) PORT="${1#*=}"; shift;;
    --trusted-host)   TRUSTED_HOST="${2:?--trusted-host needs a value}"; shift 2;;
    --trusted-host=*) TRUSTED_HOST="${1#*=}"; shift;;
    --restart) DO_RESTART=1; shift;;
    --build)   DO_BUILD=1; shift;;
    --stop)   DO_STOP=1; shift;;
    --status) DO_STATUS=1; shift;;
    --no-runtime) NO_RUNTIME=1; shift;;
    --no-render)  NO_RENDER=1; shift;;
    --with-robocasa) shift;;   # no-op: that session is ON by default now
    --with-model) WITH_MODEL=1; shift;;
    --with-policy) WITH_POLICY=1; shift;;
    -h|--help) usage; exit 0;;
    *) echo "cockpit: unknown argument: $1" >&2; usage >&2; exit 2;;
  esac
done
# --restart re-invokes the start path with every arg but --restart/--build.
START_ARGS=()
for a in "${ORIG_ARGS[@]}"; do case "$a" in --restart|--build) ;; *) START_ARGS+=("$a");; esac; done

# --- --status: the first command when something is wrong --------------------
# Starts nothing, stops nothing, needs no node. It PRINTS board.store.health --
# the same dict the console's health tool and `storecli health` return, so the
# terminal and the UI can never disagree about whether the system is up. The
# formatting is here (the human face) and the statistics stay in board/, which is
# the same split every other panel follows.
if [ "$DO_STATUS" -eq 1 ]; then
  STATUS_PY="${PH_BOARD_PYTHON:-$REPO/.venv/bin/python}"
  [ -x "$STATUS_PY" ] || STATUS_PY="$(command -v python3)"
  (cd "$REPO" && PH_WITH_MODEL="$WITH_MODEL" PH_WITH_POLICY="$WITH_POLICY" PYTHONPATH="$REPO" "$STATUS_PY" - "$REPO/runs" "$PORT") <<'PYEOF'
import sys
from board.store import health, _MODEL_START_HINT, _POLICY_START_HINT

h = health(sys.argv[1], int(sys.argv[2]))
print("cockpit --status: " +
      ("HEALTHY" if h["ok"] else f"{len(h['problems'])} PROBLEM(S)"))
for p in h["problems"]:
    print("  ! " + p)
# dormant = dead runtime, empty inbox: evidence kept, nothing to do. One line
# for all of them, so a retired session cannot make this face read red forever.
dormant = [s["name"] for s in h["sessions"] if s["state"] == "dormant"]
for s in h["sessions"]:
    if s["state"] == "dormant":
        continue
    beat = "-" if s["heartbeat_age_s"] is None else f"{s['heartbeat_age_s']:.0f}s"
    print(f"  session {s['name']:<22} {s['state'].upper():<7}"
          f"  pid={str(s['pid'] or '-'):<8} mode={str(s['mode'] or '-'):<10}"
          f" beat={beat:<8} queued={s['queued']} processing={s['processing']}"
          f" done={s['done']} failed={s['failed']}")
if dormant:
    print(f"  dormant {', '.join(dormant)} (runtime stopped, inbox empty; nothing to do)")
c, m = h["console"], h["model"]
print(f"  console 127.0.0.1:{c['port']:<11} "
      f"{'SERVING' if c['serving'] else 'DOWN'}")
print(f"  model   127.0.0.1:{m['port']:<11} "
      f"{'HEALTHY' if m['healthy'] else ('LOADING' if m['running'] else 'STOPPED')}"
      f"  pid={str(m['pid'] or '-'):<8} model={m['model']} vram_mib={m['vram_mib']}"
      + ("" if m["running"] else f"\n          {_MODEL_START_HINT}"))
p = h["policy"]
print(f"  policy  127.0.0.1:{p['port']:<11} "
      f"{'SERVING' if p['serving'] else ('LOADING' if p['running'] else 'STOPPED')}"
      f"  pid={str(p['pid'] or '-'):<8} checkpoint_sha={p['checkpoint_sha'] or '-'}"
      + ("" if p["running"] else f"\n          {_POLICY_START_HINT}"))
sys.exit(0 if h["ok"] else 1)
PYEOF
  exit $?
fi

# ph-station fork checkout: a SIBLING of the repo, same convention as the sim
# venvs below. (Was $HOME/Desktop/ph-station -- a path that exists on no machine
# we run on, so a cold start could only ever serve when a web server happened to
# already be up on $PORT and got adopted before the build check.) Overridable.
PH_STATION="${PH_STATION:-$REPO/../ph-station}"
# robocasa runtime interpreter: its venv is a SIBLING of the repo (see
# docs/project-documentation.md §5.1 -- numpy 1/2 ABI forces a separate venv).
ROBOCASA_PYTHON="${ROBOCASA_PYTHON:-$REPO/../sims/robocasa-venv/bin/python}"
PIDFILE="$REPO/$SESSION_DIR/cockpit.pids"
RUNTIME_LOG="$REPO/$SESSION_DIR/runtime.log"

# --- helpers ----------------------------------------------------------------
_alive()  { kill -0 "$1" 2>/dev/null; }
_cmd_of() { tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null; }

# PID of a live harness_runtime serving the given session dir, or empty. Reads a
# `ps` snapshot and matches in-shell (no grep child to self-match); the snapshot
# only contains processes alive when ps ran, and neither `ps` nor this shell's
# own cmdline mentions harness_runtime.py, so there is no false positive.
# The trailing space appended to $rest makes "--session-dir $sess" match on a
# word BOUNDARY: without it, session-robocasa would adopt the session-robocasa-rsi
# runtime (prefix collision) and never bring its own up.
find_runtime() {
  local sess="$1" pid rest
  ps -eo pid=,args= | while read -r pid rest; do
    case "$rest " in
      *harness_runtime.py*"--session-dir $sess "*) echo "$pid"; break;;
    esac
  done
}

# Kill an EXACT recorded PID only if its cmdline still matches (guards against
# PID reuse -- we never pattern-kill).
kill_recorded() {
  local pid="$1" needle="$2" label="$3"
  if ! _alive "$pid"; then
    echo "cockpit: $label (pid $pid) already not running" >&2
    return
  fi
  case "$(_cmd_of "$pid")" in
    *"$needle"*) kill "$pid" && echo "cockpit: stopped $label (pid $pid)" >&2;;
    *) echo "cockpit: WARNING pid $pid is not $label anymore (cmdline changed); NOT killing" >&2;;
  esac
}

# True iff pidfile $1 records $2_pid=$3 with $2_adopted=0: that process was
# spawned by an earlier cockpit, so adopting it again keeps it reapable.
owned_earlier() {
  local pf="$1" kind="$2" pid="$3"
  [ -f "$pf" ] && grep -qx "${kind}_pid=$pid" "$pf" && grep -qx "${kind}_adopted=0" "$pf"
}

# adopt-or-spawn ONE session's runtime. Sets globals RT_PID/RT_ADOPTED for the
# caller to fold into that session's pidfile. Identical discipline for every
# session: adopt a live one by cmdline match (never restart, never record for
# --stop), else spawn detached and record. allow_render=1 permits the live
# MuJoCo window (session-main); a headless-only sim (robocasa) passes 0 and
# always gets MUJOCO_GL=egl. Any further args ($4...) ride the runtime cmdline
# verbatim (e.g. --mode evolution --frames for the evolution session).
runtime_up() {
  local session="$1" interp="$2" allow_render="$3"
  shift 3
  mkdir -p "$REPO/$session"
  local existing
  existing="$(find_runtime "$session")"
  if [ -n "$existing" ]; then
    RT_PID="$existing"; RT_ADOPTED=1
    # Ownership is sticky: a runtime an EARLIER cockpit spawned (this session's
    # pidfile records the same pid with runtime_adopted=0) stays ours, so a
    # console-only restart does not turn every runtime into one --stop skips.
    if owned_earlier "$REPO/$session/cockpit.pids" runtime "$existing"; then RT_ADOPTED=0; fi
    echo "cockpit: adopting resident runtime on $session (pid $RT_PID, $([ "$RT_ADOPTED" -eq 0 ] && echo 'spawned by an earlier cockpit: --stop reaps it' || echo 'started outside cockpit: --stop leaves it')); not restarting" >&2
    return
  fi
  # Read-only-host adaptations. Both are proven by a boot that died without them
  # (session-robocasa session-log row 64):
  #   - $REPO/.robocasa-fix FIRST on PYTHONPATH: its sitecustomize redirects
  #     robocasa's assets_root to a writable mirror. Untracked and host-local, so
  #     it joins only when present; it self-disables in any interpreter that has
  #     no robocasa, which is why session-main can carry it harmlessly.
  #   - NUMBA_CACHE_DIR under the session dir: numba otherwise caches BESIDE the
  #     source file, read-only for a sandboxed runtime -- that is the
  #     RuntimeError("cannot cache function 'mat2quat'") that killed a boot.
  local pypath="$REPO"
  [ -d "$REPO/.robocasa-fix" ] && pypath="$REPO/.robocasa-fix:$REPO"
  mkdir -p "$REPO/$session/numba-cache"
  local -a spawn_env=(PYTHONPATH="$pypath" NUMBA_CACHE_DIR="$REPO/$session/numba-cache")
  local -a render_flag=()
  if [ "$allow_render" -eq 1 ] && [ "$NO_RENDER" -eq 0 ] && [ -n "${DISPLAY:-}" ]; then
    render_flag=(--render)
  else
    spawn_env+=(MUJOCO_GL=egl)   # headless: offscreen sim needs egl
  fi
  local log="$REPO/$session/runtime.log"
  # cd in a subshell so the runtime cmdline stays the canonical relative form
  # (matches find_runtime on the next boot). setsid, not just nohup: nohup only
  # blocks SIGHUP, so a runtime stayed in the launching terminal's process group
  # and a group-wide teardown (`kill -- -PGID`, an agent/CI session ending) took
  # it down mid-campaign -- 140/153 calibration episodes lost that way on
  # 2026-08-28. Its own session makes it survive whatever started it.
  RT_PID="$(cd "$REPO" && { setsid env "${spawn_env[@]}" "$interp" \
      scripts/harness_runtime.py --session-dir "$session" "${render_flag[@]}" "$@" \
      >>"$log" 2>&1 < /dev/null & echo $!; })"
  RT_ADOPTED=0
  echo "cockpit: spawned resident runtime on $session (pid $RT_PID, render=$([ ${#render_flag[@]} -gt 0 ] && echo on || echo off), log $log)" >&2
}

# Reap a runtime recorded in a pidfile: kill it by EXACT pid iff its cmdline
# still matches (never pattern-kill), or leave an adopted one running.
stop_recorded_runtime() {
  local pid="$1" adopted="$2" label="$3"
  [ -n "$pid" ] || return
  if [ "$adopted" = "0" ]; then
    kill_recorded "$pid" "harness_runtime.py" "$label"
  else
    echo "cockpit: $label pid $pid was ADOPTED (started outside cockpit); leaving it running" >&2
  fi
}

# --- --stop: read every session pidfile, kill exactly what we started -------
# The main session pidfile also carries the web pid; extra sessions (robocasa)
# carry only their runtime. Each is reaped by the SAME exact-PID + cmdline-guard
# discipline, one session at a time.
if [ "$DO_STOP" -eq 1 ]; then
  stopped_any=0
  # main session: web server + its runtime
  if [ -f "$PIDFILE" ]; then
    stopped_any=1
    web_pid=""; web_adopted="0"; runtime_pid=""; runtime_adopted="1"
    while IFS='=' read -r k v; do
      case "$k" in
        web_pid) web_pid="$v";;
        web_adopted) web_adopted="$v";;
        runtime_pid) runtime_pid="$v";;
        runtime_adopted) runtime_adopted="$v";;
      esac
    done < "$PIDFILE"
    if [ -n "$web_pid" ]; then
      if [ "$web_adopted" = "1" ]; then
        echo "cockpit: web server (pid $web_pid) was ADOPTED; leaving it up" >&2
      else
        kill_recorded "$web_pid" "web --no-open" "web server"
      fi
    fi
    stop_recorded_runtime "$runtime_pid" "$runtime_adopted" "runtime ($SESSION_DIR)"
    rm -f "$PIDFILE"
  fi
  # extra per-session runtimes (e.g. session-robocasa): each its own pidfile
  for pf in "$REPO"/runs/*/cockpit.pids; do
    [ -e "$pf" ] || continue           # no match -> glob stays literal, skip
    [ "$pf" = "$PIDFILE" ] && continue  # main already handled above
    stopped_any=1
    runtime_pid=""; runtime_adopted="1"
    while IFS='=' read -r k v; do
      case "$k" in
        runtime_pid) runtime_pid="$v";;
        runtime_adopted) runtime_adopted="$v";;
      esac
    done < "$pf"
    stop_recorded_runtime "$runtime_pid" "$runtime_adopted" "runtime ($(basename "$(dirname "$pf")"))"
    rm -f "$pf"
  done
  # policy server: only one THIS face started (its pidfile), exact pid, identity re-checked
  if [ -f "$REPO/runs/policy-server.pid" ]; then
    stopped_any=1
    STOP_PY="${PH_BOARD_PYTHON:-$REPO/.venv/bin/python}"
    [ -x "$STOP_PY" ] || STOP_PY="$(command -v python3)"
    (cd "$REPO" && PYTHONPATH="$REPO" "$STOP_PY" - "$REPO/runs") <<'PYEOF'
import sys
from board.store import policy_server
p = policy_server("stop", sys.argv[1])
print("cockpit: policy server " + (f"NOT stopped: {p['error']}" if p.get("error") else "stopped"), file=sys.stderr)
PYEOF
  fi
  [ "$stopped_any" -eq 0 ] && echo "cockpit: no pidfile under $REPO/runs/*/cockpit.pids; nothing to stop" >&2
  exit 0
fi

# --- --restart: stop + (build) + start, from a process nobody is waiting on --
# The console's restart button calls this through board.store.restart_services,
# i.e. from the very web server --stop is about to kill, so the FIRST thing is
# to re-exec detached and return; the detached copy drives --stop and the start
# path as children of itself (their stderr lands in the same log) and ends with
# ONE terminal line -- "restart done" or "ERROR ..." -- which health() reads as
# the state. The policy server is re-added ONLY if it was serving: the operator
# starts pi0.5 by hand, never as a side effect of a restart.
if [ "$DO_RESTART" -eq 1 ]; then
  RESTART_LOG="$REPO/runs/restart.log"
  mkdir -p "$REPO/runs"
  if [ -z "${PH_COCKPIT_DETACHED:-}" ]; then
    : > "$RESTART_LOG"
    PH_COCKPIT_DETACHED=1 setsid "${BASH:-bash}" "$0" "${ORIG_ARGS[@]}" >>"$RESTART_LOG" 2>&1 </dev/null &
    echo "cockpit: restarting in the background (pid $!, log $RESTART_LOG)" >&2
    exit 0
  fi
  unset PH_COCKPIT_DETACHED   # children (and the console they start) must not inherit it
  echo "cockpit: restart begin $(date '+%F %T')${DO_BUILD:+ (build=$DO_BUILD)}"
  RESTART_PY="${PH_BOARD_PYTHON:-$REPO/.venv/bin/python}"
  [ -x "$RESTART_PY" ] || RESTART_PY="$(command -v python3)"
  POLICY_WAS_SERVING="$(cd "$REPO" && PYTHONPATH="$REPO" "$RESTART_PY" - "$REPO/runs" <<'PYEOF'
import sys
from board.store import policy_server
print(int(bool(policy_server("status", sys.argv[1])["serving"])))
PYEOF
)"
  echo "cockpit: policy server was $([ "$POLICY_WAS_SERVING" = 1 ] && echo SERVING || echo 'not serving')"
  echo "cockpit: stopping"
  "${BASH:-bash}" "$0" --stop || echo "cockpit: WARNING --stop exited $? (continuing)"
  if [ "$DO_BUILD" -eq 1 ]; then
    echo "cockpit: building ph-station in $PH_STATION"
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    # shellcheck disable=SC1091
    [ -s "$NVM_DIR/nvm.sh" ] && { . "$NVM_DIR/nvm.sh"; nvm use 22 >/dev/null; }
    if ! (cd "$PH_STATION" && pnpm build); then
      echo "cockpit: ERROR pnpm build failed in $PH_STATION; restart aborted, nothing started"
      exit 1
    fi
  fi
  [ "$POLICY_WAS_SERVING" = 1 ] && START_ARGS+=(--with-policy)
  echo "cockpit: starting: cockpit ${START_ARGS[*]}"
  if "${BASH:-bash}" "$0" "${START_ARGS[@]}"; then
    echo "cockpit: restart done"
  else
    echo "cockpit: ERROR start path exited $? (see above); restart failed"
    exit 1
  fi
  exit 0
fi

# --- start path -------------------------------------------------------------
# Model server first (needs no node): the SAME board.store.model_server the
# console's toggle and `storecli model_server start` call, then wait until it
# answers -- a 27B load takes minutes and a console that reports STOPPED with
# nothing to start it is how the VLM path silently could not run.
if [ "$WITH_MODEL" = "1" ]; then
  MODEL_PY="${PH_BOARD_PYTHON:-$REPO/.venv/bin/python}"
  [ -x "$MODEL_PY" ] || MODEL_PY="$(command -v python3)"
  mkdir -p "$REPO/runs"
  # cd first: `python -` puts the CWD ahead of PYTHONPATH, so board/ must be $REPO's.
  (cd "$REPO" && PYTHONPATH="$REPO" "$MODEL_PY" - "$REPO/runs" "${PH_MODEL_WAIT_S:-600}") <<'PYEOF' || exit 1
import sys, time
from board.store import model_server

runs, deadline = sys.argv[1], time.time() + float(sys.argv[2])
m = model_server("start", runs)
if m.get("error"):
    sys.exit(f"cockpit: ERROR model server start failed: {m['error']}")
print(f"cockpit: model server pid {m['pid']} on :{m['port']}; waiting for /v1/models", file=sys.stderr)
while not m["healthy"]:
    if time.time() > deadline:
        sys.exit(f"cockpit: ERROR model server not healthy after {sys.argv[2]}s (see {runs}/model-server.log)")
    time.sleep(2)
    m = model_server("status", runs)
print(f"cockpit: model server HEALTHY ({m['model']})", file=sys.stderr)
PYEOF
fi
export PH_WITH_MODEL="$WITH_MODEL"   # the console's MCP health face inherits it

# Policy server next, same shape: board.store.policy_server('start') then wait
# for the port -- the weights take minutes and the socket only opens after.
if [ "$WITH_POLICY" = "1" ]; then
  POLICY_PY="${PH_BOARD_PYTHON:-$REPO/.venv/bin/python}"
  [ -x "$POLICY_PY" ] || POLICY_PY="$(command -v python3)"
  mkdir -p "$REPO/runs"
  (cd "$REPO" && PYTHONPATH="$REPO" "$POLICY_PY" - "$REPO/runs" "${PH_POLICY_WAIT_S:-600}" "$POLICY_CHECKPOINT") <<'PYEOF' || exit 1
import sys, time
from board.store import policy_server

runs, deadline = sys.argv[1], time.time() + float(sys.argv[2])
p = policy_server("start", runs, sys.argv[3] or None)
if p.get("error"):
    sys.exit(f"cockpit: ERROR policy server start failed: {p['error']}")
print(f"cockpit: policy server pid {p['pid']} on :{p['port']}; waiting for the port", file=sys.stderr)
while not p["serving"]:
    if time.time() > deadline:
        sys.exit(f"cockpit: ERROR policy server not serving after {sys.argv[2]}s (see {runs}/policy-server.log)")
    time.sleep(2)
    p = policy_server("status", runs)
print(f"cockpit: policy server SERVING (checkpoint_sha={p['checkpoint_sha']})", file=sys.stderr)
PYEOF
fi
export PH_WITH_POLICY="$WITH_POLICY"

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ ! -s "$NVM_DIR/nvm.sh" ]; then
  echo "cockpit: ERROR nvm not found at $NVM_DIR/nvm.sh" >&2
  exit 1
fi
# shellcheck disable=SC1091
. "$NVM_DIR/nvm.sh"
nvm use 22 >/dev/null

export DSH_HOME="${DSH_HOME:-$HOME/.dsh}"

# --- resident runtime: adopt-or-spawn (single entry means no second terminal)
RT_PID=""
MAIN_RT_PID=""; MAIN_RT_ADOPTED=""
RT_ADOPTED=""
if [ "$NO_RUNTIME" -eq 0 ]; then
  # --frames explicitly, not by the headless-GL auto-enable: a display-attached
  # spawn (render=on) leaves MUJOCO_GL unset, which used to silently switch the
  # 取景窗 OFF for a REMOTE operator -- the local window they cannot see was
  # suppressing the browser viewport they use. The two compose in _mount_plan.
  runtime_up "$SESSION_DIR" ".venv/bin/python" 1 --frames
  MAIN_RT_PID="$RT_PID"; MAIN_RT_ADOPTED="$RT_ADOPTED"   # the next runtime_up overwrites RT_*

  # Stack RSI needs the robosuite interpreter, not the robocasa venv. Keep it
  # in a separate evolution-only inbox so a long campaign cannot block normal
  # stack task execution and an execution agent cannot accidentally run RSI.
  runtime_up "$STACK_EVOLUTION_SESSION_DIR" ".venv/bin/python" 0 --mode evolution --frames
  {
    echo "runtime_pid=$RT_PID"
    echo "runtime_adopted=$RT_ADOPTED"
  } > "$REPO/$STACK_EVOLUTION_SESSION_DIR/cockpit.pids"
fi

# --- web: adopt-or-spawn (same discipline as the runtime). A server already
# on $PORT (a previous cockpit, or a deploy session's live web) is ADOPTED:
# record its REAL pid so the pidfile never lies, and --stop leaves it up
# (web_adopted=1) exactly like an adopted runtime. Without this, a second
# cockpit start spawn-crashes on EADDRINUSE and records a dead web pid.
WEB_ADOPTED=0
WEB_PID=""
if curl -sf -o /dev/null --max-time 2 "http://127.0.0.1:$PORT/"; then
  WEB_PID="$(fuser "$PORT/tcp" 2>/dev/null | awk '{print $1}')"
  WEB_ADOPTED=1
  if owned_earlier "$PIDFILE" web "$WEB_PID"; then WEB_ADOPTED=0; fi
  echo "cockpit: adopting web server already on :$PORT (pid ${WEB_PID:-unknown}, $([ "$WEB_ADOPTED" -eq 0 ] && echo 'spawned by an earlier cockpit: --stop reaps it' || echo 'started outside cockpit: --stop leaves it')); not restarting" >&2
fi

# A console-only start (--no-runtime) must not forget who owns session-main's
# runtime: carry the previous pidfile's runtime_* lines over, or the next --stop
# treats a runtime an earlier cockpit spawned as "started outside" and skips it
# (2026-09-03: a one-click restart left session-main on stale code this way).
if [ -z "$MAIN_RT_PID" ] && [ -f "$PIDFILE" ]; then
  MAIN_RT_PID="$(sed -n 's/^runtime_pid=//p' "$PIDFILE")"
  MAIN_RT_ADOPTED="$(sed -n 's/^runtime_adopted=//p' "$PIDFILE")"
fi

# record PIDs for --stop. Spawned web_pid=$$: this shell is replaced by the web
# server via exec below, so $$ is the server's PID after exec.
{
  if [ "$WEB_ADOPTED" -eq 1 ]; then echo "web_pid=$WEB_PID"; else echo "web_pid=$$"; fi
  echo "web_adopted=$WEB_ADOPTED"
  echo "port=$PORT"
  if [ -n "$MAIN_RT_PID" ]; then
    echo "runtime_pid=$MAIN_RT_PID"
    echo "runtime_adopted=$MAIN_RT_ADOPTED"
  fi
} > "$PIDFILE"

# --- the two robocasa-venv runtimes: kitchen + evolution (both ON by default)
# Both are inboxes the console submits into, so cockpit manages both for the one
# reason in the header: an un-managed runtime dies unnoticed and briefs rot in
# its inbox. Same adopt-or-spawn + exact-PID pidfile discipline each (its own
# runs/<session>/cockpit.pids, reaped by the generic --stop loop); headless
# (MUJOCO_GL=egl via allow_render=0). ONE venv guard for the pair: a missing
# robocasa venv warns and skips both -- never blocks the console.
if [ "$NO_RUNTIME" -eq 0 ]; then
  if [ -x "$ROBOCASA_PYTHON" ]; then
    runtime_up "$ROBOCASA_SESSION_DIR" "$ROBOCASA_PYTHON" 0 --frames
    {
      echo "runtime_pid=$RT_PID"
      echo "runtime_adopted=$RT_ADOPTED"
    } > "$REPO/$ROBOCASA_SESSION_DIR/cockpit.pids"
    runtime_up "$EVOLUTION_SESSION_DIR" "$ROBOCASA_PYTHON" 0 --mode evolution --frames
    {
      echo "runtime_pid=$RT_PID"
      echo "runtime_adopted=$RT_ADOPTED"
    } > "$REPO/$EVOLUTION_SESSION_DIR/cockpit.pids"
  else
    echo "cockpit: WARNING robocasa venv missing at $ROBOCASA_PYTHON; NEITHER robocasa runtime started ($ROBOCASA_SESSION_DIR, $EVOLUTION_SESSION_DIR)" >&2
  fi
fi

# adopted web: runtimes are up and recorded; nothing left to serve.
if [ "$WEB_ADOPTED" -eq 1 ]; then
  exit 0
fi

# --- serve the ph-station fork build -----------------------------------------
BIN="$PH_STATION/apps/cli/lib/bin.js"
DIST="$PH_STATION/apps/web/dist/index.html"
if [ ! -f "$DIST" ] || [ ! -f "$BIN" ]; then
  echo "cockpit: ERROR ph-station build missing ($DIST / $BIN)." >&2
  echo "cockpit: run 'pnpm run build' in $PH_STATION." >&2
  exit 1
fi

# A fresh clone has no runs/ -- it is gitignored evidence. board/mcp_server.py
# REFUSES to start on a missing runs dir (a deliberate typo guard), so without
# this the console comes up with the harness MCP row failing to compose and the
# agent silently toolless. The runtime path already mkdirs its own session dir;
# this covers --no-runtime and the very first start after a clone.
mkdir -p "$REPO/runs"

# render $DSH_HOME/cordis.patch.yml from the committed template. This is what
# gives the console its mcp__physical-harness__* tools, its LLM route and the
# `physical` agent preset, and dsh has no --patch flag, so the file must exist
# BEFORE the server starts. It is the one step that must never fail quietly:
# without it the agent has no harness tools at all and falls back to native
# bash -- the ungoverned path the MCP server exists to prevent.
if ! python3 "$REPO/profiles/dsh/deploy_profile.py" --repo "$REPO" --dsh-home "$DSH_HOME"; then
  echo "cockpit: ERROR could not render $DSH_HOME/cordis.patch.yml" >&2
  echo "cockpit: WITHOUT IT THE AGENT HAS NO mcp__physical-harness__* TOOLS -- it" >&2
  echo "cockpit:   falls back to native bash, the ungoverned path. Refusing to serve." >&2
  exit 1
fi

# seed the workspace user-data record (orthogonal to brand; native brand does
# not seed a workspace). MUST run before the server starts -- the server holds
# the workspace unit open and republishes the whole file on every mutation.
if ! python3 "$REPO/profiles/dsh/seed_workspace.py" --workspace "$REPO" --dsh-home "$DSH_HOME"; then
  echo "cockpit: WARNING workspace seed reported an issue; console still serves" >&2
fi

# BoardBridge box paths (the fork-only channel): the web-app bundle's
# board-bridge row reads these PH_BOARD_* env vars via !!js and disables itself
# when PH_BOARD_REPO is unset, so the 战报 panel's /api/board/* endpoints only
# come alive on this fork path. The board host package ships in the fork bundle,
# never in $DSH_HOME/cordis.patch.yml (design §3).
export PH_BOARD_PYTHON="${PH_BOARD_PYTHON:-$REPO/.venv/bin/python}"
export PH_BOARD_REPO="${PH_BOARD_REPO:-$REPO}"
export PH_BOARD_RUNS="${PH_BOARD_RUNS:-$REPO/runs}"

echo "cockpit: serving physical-harness console (fork build) at http://127.0.0.1:$PORT" >&2
# cd to the repo root FIRST: dsh's credential store falls back to `<invocation
# cwd>/.env`, so without this the keys the console can see depend on which
# directory the operator happened to type the command in.
cd "$REPO" || { echo "cockpit: ERROR cannot cd to $REPO" >&2; exit 1; }
# setsid + background, NOT exec: the console must outlive the terminal that
# started it. The runtimes already do (runtime_up spawns them with setsid), so an
# exec'd web server meant a closed terminal left the operator with live runtimes
# and a dead UI -- the one surface they actually use. Logs go to a file because a
# detached process has no terminal to write to.
WEB_LOG="$REPO/$SESSION_DIR/web.log"
setsid node "$BIN" web --no-open --port "$PORT" \
  ${TRUSTED_HOST:+--trusted-host "$TRUSTED_HOST"} >>"$WEB_LOG" 2>&1 </dev/null &
WEB_SPAWNED=$!
# The pidfile above recorded $$ on the assumption that exec would replace this
# shell with node. It no longer does, so correct the row to the pid that is
# actually serving -- --stop kills by that exact pid (with a cmdline re-check).
sed -i "s/^web_pid=.*/web_pid=$WEB_SPAWNED/" "$PIDFILE"
echo "cockpit: console detached (pid $WEB_SPAWNED, log $WEB_LOG); this terminal is free" >&2
