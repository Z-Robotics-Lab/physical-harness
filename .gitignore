.venv
# machine-local console config + credentials; the committed template is
# .env.example. NO trailing slash -- a pattern with one matches only a
# directory, and this repo has already lost data to `runs/` failing that way.
.env
# per-sim interpreters + third-party sim checkouts (docs/project-documentation.md §5);
# venvs and cloned sim repos never enter git
sims/
# the worktree's sims may be a symlink to the main checkout's; `sims/` alone does not match one
sims
__pycache__/
*.pyc
runs
.pytest_cache/
.ruff_cache/
*.egg-info/
.DS_Store

# local-only iteration record (worklog + archived round docs); never pushed.
# progress.md must stay resolvable at repo root: the live cockpit rounds feed
# reads it there (board.parse_rounds), it is just not tracked.
local-archive/
progress.md

# operator progress ledgers/worklogs: local-only, the public repo ships standard docs
STATUS.md

# development docs: current-state worklog + open campaign goals. The public set
# is ONE file (docs/project-documentation.md); everything a stranger does not
# need lives here or in local-archive/docs/. NO trailing slash -- see .env above.
docs-dev

# read-only-host RoboCasa adaptation (see .robocasa-fix/sitecustomize.py): the
# writable assets mirror + the PYTHONPATH hook that redirects assets_root to it.
.robocasa-assets/
.robocasa-fix/
# stray numba cache from a launch that predates cockpit setting NUMBA_CACHE_DIR
# (spawns now cache under runs/<session>/numba-cache, already ignored above).
.numba-cache/

# model-written candidate cards are run artefacts: they land under plugins/candidates/
# from an evolve round and are published as a record binding, never as source in git
plugins/candidates/*
!plugins/candidates/grasp_geometric_robocasa/
MUJOCO_LOG.TXT
